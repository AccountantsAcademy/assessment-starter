MONGODB_URI=mongodb://localhost:27017/assessment

# LLM: "mock" (default, no setup needed) or "ollama" (real local model)
LLM_PROVIDER=mock
# Probability (0-1) that a mock call misbehaves. 0 = always well-behaved.
LLM_MOCK_CHAOS=0.1
# Optional: make every call fail in one way: timeout | rate-limit | malformed-json | interrupt
# LLM_MOCK_FORCE=timeout
# Optional: same seed = same sequence of delays and failures
# LLM_MOCK_SEED=42
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
